# Copy to .env.local (git-ignored) and fill in values from
# Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# reCAPTCHA Enterprise site key registered for App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key

# Optional, dev only (`npm run dev`). Leave empty on first run: the App Check SDK
# logs a generated debug token in the browser console. Register it in
# Firebase console > App Check > Apps > Manage debug tokens, then paste it here.
# Never commit a real value; it is ignored in production builds.
VITE_APPCHECK_DEBUG_TOKEN=
